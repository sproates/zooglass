{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "dist",
    "skipLibCheck": true,
    "paths": {
      "/vendor/leaflet/leaflet-src.esm.js": [
        "../../workbench/node_modules/@types/leaflet"
      ]
    }
  },
  "include": ["src/**/*.ts"]
}
