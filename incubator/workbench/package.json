{
  "name": "scenario-simulation-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "prebuild": "node scripts/check-node-version.js",
    "build": "tsc -p tsconfig.json",
    "prelint": "node scripts/check-node-version.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "predev": "node scripts/check-node-version.js",
    "dev": "tsx watch src/index.ts",
    "presimulate": "node scripts/check-node-version.js",
    "simulate": "tsx src/index.ts",
    "prestart": "node scripts/check-node-version.js",
    "start": "node dist/index.js",
    "pretest": "node scripts/check-node-version.js",
    "test": "tsx --test test/*.test.ts test/scenarios/*.test.ts",
    "pretypecheck": "node scripts/check-node-version.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
