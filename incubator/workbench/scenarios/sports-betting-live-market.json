{
  "name": "A live sports betting market combines score and odds feeds",
  "sources": [
    {
      "id": "match-feed",
      "name": "Match data provider"
    },
    {
      "id": "bookmaker",
      "name": "Bookmaker odds feed"
    }
  ],
  "clients": [
    {
      "id": "market-screen",
      "name": "Live market screen",
      "initialState": "connected"
    }
  ],
  "views": [
    {
      "id": "market",
      "fields": {
        "score": [
          {
            "sourceId": "match-feed",
            "type": "score.updated"
          }
        ],
        "odds": [
          {
            "sourceId": "bookmaker",
            "type": "odds.updated"
          }
        ]
      }
    }
  ],
  "timeline": [
