{
  "name": "Workbench drives ZooGlass connections and events",
  "sources": [{ "id": "test-feed", "name": "Test feed" }],
  "clients": [
    { "id": "viewer-1", "name": "Test viewer", "initialState": "disconnected" }
  ],
  "timeline": [
    {
      "kind": "client-state",
      "simulationTime": 0,
      "clientId": "viewer-1",
      "state": "connecting"
    },
    {
      "kind": "source-event",
      "simulationTime": 0,
      "sourceId": "test-feed",
      "type": "test.first",
      "entityId": "item-1",
      "payload": { "marker": "first" }
    },
    {
      "kind": "client-state",
      "simulationTime": 10,
      "clientId": "viewer-1",
      "state": "connected"
    },
    {
      "kind": "client-state",
      "simulationTime": 100,
      "clientId": "viewer-1",
      "state": "disconnecting"
    },
    {
      "kind": "client-state",
      "simulationTime": 110,
      "clientId": "viewer-1",
      "state": "disconnected"
    },
    {
      "kind": "source-event",
      "simulationTime": 120,
      "sourceId": "test-feed",
      "type": "test.during-disconnect",
      "entityId": "item-1",
      "payload": { "marker": "during-disconnect" }
    },
    {
      "kind": "client-state",
      "simulationTime": 200,
      "clientId": "viewer-1",
      "state": "connecting"
    },
    {
      "kind": "source-event",
      "simulationTime": 220,
      "sourceId": "test-feed",
      "type": "test.after-reconnect",
      "entityId": "item-1",
      "payload": { "marker": "after-reconnect" }
    },
    {
      "kind": "client-state",
      "simulationTime": 300,
      "clientId": "viewer-1",
      "state": "disconnected"
    }
  ]
}
