{
  "name": "scenario-simulation-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "prepare:service": "node scripts/check-node-version.js && node scripts/prepare-service.js",
    "prebuild": "node scripts/check-node-version.js",
    "build": "tsc -p tsconfig.json && npm run build:browser",
    "prelint": "node scripts/check-node-version.js",
    "lint": "eslint . && cd ../demos/vehicle-tracker && eslint .",
    "format": "prettier --write . ../demos/vehicle-tracker",
    "format:check": "prettier --check . ../demos/vehicle-tracker",
    "predev": "node scripts/check-node-version.js",
    "dev": "tsx watch src/cli/simulate.ts",
    "presimulate": "node scripts/check-node-version.js",
    "simulate": "tsx src/cli/simulate.ts",
    "preintegrate": "node scripts/check-node-version.js",
    "integrate": "tsx src/cli/integrate.ts",
    "prestart": "node scripts/check-node-version.js",
    "start": "node dist/cli/simulate.js",
    "pretest": "node scripts/check-node-version.js && npm run build:browser",
    "test": "tsx --test test/*.test.ts test/scenarios/*.test.ts test/demo-unit/*.test.ts",
    "pretypecheck": "node scripts/check-node-version.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p ../demos/vehicle-tracker/tsconfig.json",
    "predemo": "node scripts/check-node-version.js && npm run build:browser",
    "demo": "tsx src/demos/vehicle/demo.ts",
    "pretest:browser": "node scripts/check-node-version.js && npm run build:browser",
    "test:browser": "tsx --test test/browser/*.test.ts",
    "build:browser": "tsc -p ../demos/vehicle-tracker/tsconfig.json",
    "test:coverage": "c8 --reports-dir=coverage/standard npm test",
    "test:browser:coverage": "c8 --reports-dir=coverage/browser-host npm run test:browser",
    "pretest:resources": "node scripts/check-node-version.js && npm run build:browser",
    "test:reconnect": "tsx --test test/resources/reconnect.test.ts",
    "test:resources": "tsx --test --test-concurrency=1 test/resources/*.test.ts",
    "pretest:engines": "node scripts/check-node-version.js && npm run build:browser",
    "test:engines": "tsx --test test/platform/*.test.ts",
    "pretest:core": "node scripts/check-node-version.js",
    "test:core": "tsx --test test/*.test.ts test/scenarios/*.test.ts",
    "pretest:demo-unit": "node scripts/check-node-version.js && npm run build:browser",
    "test:demo-unit": "tsx --test test/demo-unit/*.test.ts",
    "predemo:drive": "node scripts/check-node-version.js && npm run build:browser",
    "demo:drive": "tsx src/demos/vehicle/demo.ts vehicle-tracker --continuous",
    "prepare:timeline": "node scripts/check-node-version.js && node scripts/prepare-timeline.js",
    "timeline:proof": "node --import tsx src/timeline/run.ts",
    "test:timeline-packaging": "node --import tsx --test test/packaging/*.test.ts",
    "test:timeline": "node --import tsx --test test/timeline/*.test.ts",
    "timeline:repeat": "node --import tsx scripts/timeline-repeat.ts",
    "timeline:inspect": "node --import tsx src/timeline/inspect.ts",
    "timeline:execute": "node --import tsx src/timeline/document-cli.ts",
    "timeline:replay": "node --import tsx src/timeline/replay-cli.ts",
    "timeline:bundle": "node --import tsx src/timeline/bundle-cli.ts",
    "timeline:clock-leak": "node --import tsx scripts/clock-leak-check.ts",
    "timeline:document-repeat": "node --import tsx scripts/document-repeat.ts",
    "timeline:lifecycle-repeat": "node --import tsx scripts/lifecycle-repeat.ts",
    "timeline:sqlite-repeat": "node --import tsx scripts/sqlite-repeat.ts",
    "prepare:generation-clock-control": "python3 scripts/prepare-generation-clock-mutation.py",
    "timeline:generation-clock-control": "node --import tsx scripts/generation-clock-check.ts",
    "timeline:fleet-repeat": "node --import tsx scripts/fleet-repeat.ts",
    "prepare:fleet-strategy-control": "python3 scripts/prepare-fleet-strategy-mutation.py",
    "timeline:fleet-strategy-control": "node --import tsx scripts/fleet-strategy-check.ts",
    "timeline:fleet-service-parity": "node --import tsx scripts/fleet-service-parity.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/leaflet": "1.9.21",
    "@types/node": "^26.0.0",
    "@types/ws": "8.18.2",
    "@types/yauzl": "3.4.0",
    "c8": "12.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "fflate": "0.8.3",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "playwright": "1.64.1",
    "ws": "8.22.0",
    "yauzl": "3.4.0"
  }
}
