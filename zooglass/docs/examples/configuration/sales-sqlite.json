{
  "contractVersion": 2,
  "storage": "sqlite",
  "maxStreams": 100,
  "identityWindow": 1000,
  "maxHistoryEntries": 1000,
  "sources": [
    {
      "id": "sales",
      "epoch": "day-1"
    }
  ],
  "views": [
    {
      "id": "sales-summary",
      "fields": {
        "items": {
          "sourceId": "sales",
          "type": "sale",
