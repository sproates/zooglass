          "facts": {
            "revision": "latestFactRevision",
            "maxRetainedFacts": 100,
            "minimumBirthSequence": 1
          }
        },
        "total": {
          "sourceId": "sales",
          "type": "sale",
          "mode": "sumActiveFacts",
          "property": "amount",
          "facts": {
            "revision": "latestFactRevision",
            "maxRetainedFacts": 100,
            "minimumBirthSequence": 1
          }
        }
      }
    }
  ]
}
